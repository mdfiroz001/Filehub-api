{
  "version": 2,
  "rewrites": [
    { "source": "/file/:slug", "destination": "/api/og?slug=:slug" },
    { "source": "/banner/:id", "destination": "/api/og?banner=:id" },
    { "source": "/template/:id", "destination": "/api/og?template=:id" },
    { "source": "/templates", "destination": "/api/og?page=templates" },
    { "source": "/files", "destination": "/api/og?page=files" },
    { "source": "/prompts", "destination": "/api/og?page=prompts" },
    { "source": "/register", "destination": "/api/og?page=register" },
    { "source": "/admin", "destination": "/FILEHUB.html" },
    { "source": "/admin/(.*)", "destination": "/FILEHUB.html" }
  ]
}
